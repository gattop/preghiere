---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Proponi una preghiera" description="Proponi una nuova preghiera da aggiungere al sito Spada dello Spirito.">
  <div class="page-header">
    <h1>Proponi una preghiera</h1>
    <p class="page-subtitle">Hai una preghiera che vorresti vedere sul sito? Scrivici!</p>
  </div>

  <div id="proposta-root">
    <form id="proposta-form" class="proposta-form">
      <div class="form-group">
        <label for="nome-preghiera">Nome della preghiera</label>
        <input type="text" id="nome-preghiera" name="nome" required maxlength="200" placeholder="Es. Preghiera a San Giuseppe" />
      </div>
      <div class="form-group">
        <label for="testo-preghiera">Testo della preghiera</label>
        <textarea id="testo-preghiera" name="testo" required rows="8" maxlength="5000" placeholder="Inserisci il testo completo della preghiera..."></textarea>
      </div>
      <div class="form-group">
        <label for="note">Note o fonte (opzionale)</label>
        <input type="text" id="note" name="note" maxlength="500" placeholder="Es. Libro di preghiere, tradizione diocesana..." />
      </div>
      <div id="proposta-error" class="auth-error hidden"></div>
      <div id="proposta-success" class="auth-success hidden"></div>
      <button type="submit" id="submit-btn" class="btn btn-primary">Invia proposta</button>
    </form>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase'

  const form = document.getElementById('proposta-form') as HTMLFormElement
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement
  const errorDiv = document.getElementById('proposta-error')!
  const successDiv = document.getElementById('proposta-success')!

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    errorDiv.classList.add('hidden')
    successDiv.classList.add('hidden')

    const nome = (form.elements.namedItem('nome') as HTMLInputElement).value.trim()
    const testo = (form.elements.namedItem('testo') as HTMLTextAreaElement).value.trim()
    const note = (form.elements.namedItem('note') as HTMLInputElement).value.trim()

    submitBtn.disabled = true

    const { data: { session } } = await supabase.auth.getSession()
    if (!session) {
      window.location.href = '/accedi'
      return
    }

    const { error } = await supabase.from('prayer_proposals').insert({
      title: nome,
      content: testo,
      author_note: note || null,
      user_id: session.user.id,
    })

    if (error) {
      errorDiv.textContent = 'Errore nell\'invio. Riprova più tardi.'
      errorDiv.classList.remove('hidden')
      submitBtn.disabled = false
    } else {
      successDiv.textContent = 'Proposta inviata! Grazie per il tuo contributo.'
      successDiv.classList.remove('hidden')
      form.reset()
      submitBtn.disabled = false
    }
  })
</script>
