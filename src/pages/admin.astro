---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Amministrazione" description="Pannello di amministrazione." noindex={true}>
  <div class="page-header">
    <h1>Amministrazione</h1>
  </div>
  <div id="admin-root">
    <p class="loading-text">Verifica permessi...</p>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase'
  import { escHtml } from '../utils/escHtml'

  const root = document.getElementById('admin-root')!

  async function load() {
    const { data: { session } } = await supabase.auth.getSession()
    if (!session) {
      window.location.href = '/accedi'
      return
    }

    // Check admin role
    const { data: profile } = await supabase
      .from('profiles')
      .select('is_admin')
      .eq('id', session.user.id)
      .maybeSingle()

    if (!profile || !profile.is_admin) {
      root.innerHTML = '<p class="error-text">Accesso negato.</p>'
      return
    }

    // Load proposals
    const { data: proposals } = await supabase
      .from('prayer_proposals')
      .select('id, title, content, author_note, created_at, user_id')
      .order('created_at', { ascending: false })

    if (!proposals || proposals.length === 0) {
      root.innerHTML = '<p>Nessuna proposta ricevuta.</p>'
      return
    }

    const items = proposals.map(p => `
      <div class="admin-card">
        <h3 class="admin-card-title">${escHtml(p.title)}</h3>
        <pre class="admin-card-body">${escHtml(p.content)}</pre>
        ${p.author_note ? `<p class="admin-card-notes"><em>Note: ${escHtml(p.author_note)}</em></p>` : ''}
        <p class="admin-card-meta">Inviata: ${new Date(p.created_at).toLocaleDateString('it-IT')}</p>
        <button class="btn btn-danger btn-sm" data-id="${escHtml(p.id)}">Elimina</button>
      </div>
    `).join('')

    root.innerHTML = `
      <p class="admin-count">${proposals.length} propost${proposals.length === 1 ? 'a' : 'e'}</p>
      <div class="admin-list">${items}</div>
    `

    root.querySelectorAll<HTMLButtonElement>('button[data-id]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id!
        if (!confirm('Eliminare questa proposta?')) return
        await supabase.from('prayer_proposals').delete().eq('id', id)
        btn.closest('.admin-card')?.remove()
      })
    })
  }

  load()
</script>
