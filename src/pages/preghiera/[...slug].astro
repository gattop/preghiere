---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { FOLDERS } from '../../data/folders'
import FavoriteButton from '../../components/FavoriteButton'
import PrayedTodayButton from '../../components/PrayedTodayButton'

export async function getStaticPaths() {
  const prayers = await getCollection('prayers')
  return prayers.map(prayer => {
    const siblings = prayers
      .filter(p => p.data.folder === prayer.data.folder)
      .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
    const idx = siblings.findIndex(p => p.id === prayer.id)
    const prev = idx > 0 ? siblings[idx - 1] : null
    const next = idx < siblings.length - 1 ? siblings[idx + 1] : null
    return {
      params: { slug: prayer.id.replace(/\.md$/, '') },
      props: { prayer, prev, next },
    }
  })
}

const { prayer, prev, next } = Astro.props
const { Content } = await render(prayer)
const prayerId = prayer.id.replace(/\.md$/, '')

const folderMeta = FOLDERS[prayer.data.folder]
const folderTitle = folderMeta?.title ?? prayer.data.folder
const folderUrl = `/cartella/${prayer.data.folder}`

// Breadcrumb: un crumb per ogni livello della cartella (Home > ... > cartella corrente)
const folderParts = prayer.data.folder.split('/')
const breadcrumbFolders = folderParts.map((_, i) => {
  const path = folderParts.slice(0, i + 1).join('/')
  return { title: FOLDERS[path]?.title ?? path.split('/').pop(), url: `/cartella/${path}` }
})

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://spadadellospirito.org" },
    { "@type": "ListItem", "position": 2, "name": folderTitle, "item": `https://spadadellospirito.org${folderUrl}` },
    { "@type": "ListItem", "position": 3, "name": prayer.data.title, "item": `https://spadadellospirito.org/preghiera/${prayerId}` },
  ]
}
---

<Layout title={prayer.data.title} description={prayer.data.description} jsonLd={breadcrumbJsonLd}>
  <nav class="breadcrumb" aria-label="Percorso">
    <a href="/">Home</a>
    {breadcrumbFolders.map(b => (
      <>
        <span class="breadcrumb-sep">›</span>
        <a href={b.url}>{b.title}</a>
      </>
    ))}
    <span class="breadcrumb-sep">›</span>
    <span class="breadcrumb-current" aria-current="page">{prayer.data.title}</span>
  </nav>

  <a href={folderUrl} class="back-link">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    {folderTitle}
  </a>

  <div class="prayer-header">
    <div class="prayer-header-main">
      <h1 class="prayer-title">{prayer.data.title}</h1>
      {prayer.data.subtitle && <p class="prayer-subtitle">{prayer.data.subtitle}</p>}
      {prayer.data.description && <p class="prayer-description">{prayer.data.description}</p>}
    </div>
    <div class="prayer-actions">
      <div class="font-size-controls" role="group" aria-label="Dimensione testo">
        <button class="font-size-btn" id="font-size-dec" title="Testo più piccolo" aria-label="Testo più piccolo">A−</button>
        <button class="font-size-btn" id="font-size-inc" title="Testo più grande" aria-label="Testo più grande">A+</button>
      </div>
      <FavoriteButton prayerId={prayerId} client:visible />
      <button
        class="print-btn"
        id="print-btn"
        title="Stampa"
        aria-label="Stampa questa preghiera"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      </button>
      <button
        class="share-btn"
        id="share-btn"
        title="Condividi"
        aria-label="Condividi questa preghiera"
        style="display:none"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
      </button>
    </div>
  </div>

  <div style="display:flex;justify-content:flex-end;margin-bottom:.3rem">
    <PrayedTodayButton prayerId={prayerId} client:visible />
  </div>

  <div class="prayer-body">
    <Content />
  </div>

  {(prev || next) && (
    <div class="prayer-siblings">
      {prev ? (
        <a href={`/preghiera/${prev.id.replace(/\.md$/, '')}`} class="prayer-sibling-link prev">
          <span class="prayer-sibling-label">← Precedente</span>
          <span class="prayer-sibling-title">{prev.data.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a href={`/preghiera/${next.id.replace(/\.md$/, '')}`} class="prayer-sibling-link next">
          <span class="prayer-sibling-label">Successiva →</span>
          <span class="prayer-sibling-title">{next.data.title}</span>
        </a>
      ) : <span />}
    </div>
  )}
</Layout>

<script>
  const btn = document.getElementById('share-btn') as HTMLButtonElement | null
  if (btn && 'share' in navigator) {
    btn.style.display = 'flex'
    btn.addEventListener('click', () => {
      navigator.share({
        title: document.title,
        url: window.location.href,
      }).catch(() => {})
    })
  }
</script>

<script>
  // ─ Dimensione testo (persistita, applicata via --prayer-scale) ──
  const SCALES = [0.85, 0.9, 1, 1.1, 1.2, 1.3]
  const decBtn = document.getElementById('font-size-dec') as HTMLButtonElement | null
  const incBtn = document.getElementById('font-size-inc') as HTMLButtonElement | null
  const body = document.querySelector('.prayer-body') as HTMLElement | null

  if (decBtn && incBtn && body) {
    let idx = SCALES.indexOf(1)
    const saved = parseFloat(localStorage.getItem('prayer-font-scale') ?? '')
    if (!Number.isNaN(saved) && SCALES.includes(saved)) idx = SCALES.indexOf(saved)

    function apply() {
      body!.style.setProperty('--prayer-scale', String(SCALES[idx]))
      decBtn!.disabled = idx === 0
      incBtn!.disabled = idx === SCALES.length - 1
      localStorage.setItem('prayer-font-scale', String(SCALES[idx]))
    }

    decBtn.addEventListener('click', () => { idx = Math.max(0, idx - 1); apply() })
    incBtn.addEventListener('click', () => { idx = Math.min(SCALES.length - 1, idx + 1); apply() })
    apply()
  }
</script>

<script>
  document.getElementById('print-btn')?.addEventListener('click', () => window.print())
</script>
