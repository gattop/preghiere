---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { FOLDERS } from '../../data/folders'
import FavoriteButton from '../../components/FavoriteButton'

export async function getStaticPaths() {
  const prayers = await getCollection('prayers')
  return prayers.map(prayer => ({
    params: { slug: prayer.id.replace(/\.md$/, '') },
    props: { prayer },
  }))
}

const { prayer } = Astro.props
const { Content } = await render(prayer)
const prayerId = prayer.id.replace(/\.md$/, '')

const folderMeta = FOLDERS[prayer.data.folder]
const folderTitle = folderMeta?.title ?? prayer.data.folder
const folderUrl = `/cartella/${prayer.data.folder}`

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://spadadellospirito.org" },
    { "@type": "ListItem", "position": 2, "name": folderTitle, "item": `https://spadadellospirito.org${folderUrl}` },
    { "@type": "ListItem", "position": 3, "name": prayer.data.title, "item": `https://spadadellospirito.org/preghiera/${prayerId}` },
  ]
}
---

<Layout title={prayer.data.title} description={prayer.data.description} jsonLd={breadcrumbJsonLd}>
  <a href={folderUrl} class="back-link">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    {folderTitle}
  </a>

  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:1rem">
    <div style="flex:1">
      <h1 style="text-align:left;font-size:clamp(1.3rem,4vw,1.75rem);font-weight:700;letter-spacing:-.01em">{prayer.data.title}</h1>
      {prayer.data.subtitle && <p class="prayer-subtitle">{prayer.data.subtitle}</p>}
      {prayer.data.description && <p class="prayer-description">{prayer.data.description}</p>}
    </div>
    <div style="display:flex;gap:.5rem;align-items:center;padding-top:.5rem">
      <button class="read-toggle" id="read-toggle" aria-pressed="false" title="Modalità lettura">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        Lettura
      </button>
      <FavoriteButton prayerId={prayerId} client:visible />
      <button
        class="share-btn"
        id="share-btn"
        title="Condividi"
        aria-label="Condividi questa preghiera"
        style="display:none"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
      </button>
    </div>
  </div>

  <div class="prayer-body">
    <Content />
  </div>
</Layout>

<script>
  const btn = document.getElementById('share-btn') as HTMLButtonElement | null
  if (btn && 'share' in navigator) {
    btn.style.display = 'flex'
    btn.addEventListener('click', () => {
      navigator.share({
        title: document.title,
        url: window.location.href,
      }).catch(() => {})
    })
  }
</script>

<script>
  const toggle = document.getElementById('read-toggle') as HTMLButtonElement | null
  const prayerBody = document.querySelector('.prayer-body')
  if (toggle && prayerBody) {
    const active = localStorage.getItem('prayer-reading-mode') === '1'
    if (active) {
      prayerBody.classList.add('is-reading')
      toggle.classList.add('active')
      toggle.setAttribute('aria-pressed', 'true')
    }
    toggle.addEventListener('click', () => {
      const on = prayerBody.classList.toggle('is-reading')
      toggle.classList.toggle('active', on)
      toggle.setAttribute('aria-pressed', String(on))
      localStorage.setItem('prayer-reading-mode', on ? '1' : '0')
    })
  }
</script>
