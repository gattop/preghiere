---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Il mio profilo" description="Gestisci il tuo account Spada dello Spirito." noindex={true}>
  <div class="page-header">
    <h1>Il mio profilo</h1>
  </div>

  <div id="profile-root" class="profile-page">
    <p class="loading-text">Caricamento...</p>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase'
  import { escHtml } from '../utils/escHtml'

  const root = document.getElementById('profile-root')!

  async function load() {
    const { data: { session } } = await supabase.auth.getSession()
    if (!session) {
      window.location.href = '/accedi'
      return
    }

    const user = session.user
    const { data: profile } = await supabase
      .from('profiles')
      .select('display_name, receive_daily_gospel')
      .eq('id', user.id)
      .maybeSingle()

    const gospelChecked = profile?.receive_daily_gospel ? 'checked' : ''

    root.innerHTML = `
      <div class="profile-card">
        <p class="profile-email">${escHtml(user.email ?? '')}</p>
        <p class="profile-since">Iscritto da: ${new Date(user.created_at).toLocaleDateString('it-IT')}</p>

        <div class="toggle-row">
          <label class="toggle-label" for="gospel-toggle">
            📖 Ricevi il Vangelo del giorno via email
          </label>
          <input type="checkbox" id="gospel-toggle" ${gospelChecked}
            style="width:1.2rem;height:1.2rem;cursor:pointer;accent-color:var(--accent)" />
        </div>

        <div class="profile-actions">
          <button id="logout-btn" class="btn btn-secondary">Esci dall'account</button>
          <button id="delete-btn" class="btn btn-danger">Elimina account</button>
        </div>
        <div id="profile-error" class="auth-error hidden"></div>
      </div>
    `

    // Toggle vangelo giornaliero
    document.getElementById('gospel-toggle')!.addEventListener('change', async (e) => {
      const checked = (e.target as HTMLInputElement).checked
      await supabase.from('profiles').update({ receive_daily_gospel: checked }).eq('id', user.id)
    })

    document.getElementById('logout-btn')!.addEventListener('click', async () => {
      await supabase.auth.signOut()
      window.location.href = '/'
    })

    document.getElementById('delete-btn')!.addEventListener('click', async () => {
      if (!confirm('Sei sicuro di voler eliminare il tuo account? Questa azione è irreversibile.')) return
      const errorDiv = document.getElementById('profile-error')!
      try {
        const { error } = await supabase.functions.invoke('delete-account')
        if (error) throw error
        await supabase.auth.signOut()
        window.location.href = '/'
      } catch (e: unknown) {
        errorDiv.textContent = e instanceof Error ? e.message : 'Errore durante l\'eliminazione.'
        errorDiv.classList.remove('hidden')
      }
    })
  }

  load()
</script>
