---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Accedi" description="Accedi al tuo account Spada dello Spirito o crea un nuovo profilo.">
  <div class="auth-page">
    <div class="auth-card">
      <h1 class="auth-title">Accedi</h1>
      <p class="auth-subtitle">Entra con il tuo account o registrati</p>

      <div id="auth-error" class="auth-error hidden"></div>
      <div id="auth-success" class="auth-success hidden"></div>

      <form id="auth-form" class="auth-form">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required autocomplete="email" class="form-input" />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <div class="pwd-wrap">
            <input type="password" id="password" name="password" required autocomplete="current-password" minlength="6" maxlength="64" class="form-input" />
            <button type="button" class="pwd-toggle" id="pwd-toggle" aria-label="Mostra/nascondi password" tabindex="-1">
              <svg id="pwd-icon-hide" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg id="pwd-icon-show" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
        </div>
        <div class="auth-actions">
          <button type="submit" id="login-btn" class="btn btn-primary">Accedi</button>
          <button type="button" id="register-btn" class="btn btn-secondary">Registrati</button>
        </div>
        <p style="text-align:center;margin-top:.8rem;font-size:.82rem">
          <a href="/reset-password" style="color:var(--accent);text-decoration:none">Hai dimenticato la password?</a>
        </p>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase'

  const form = document.getElementById('auth-form') as HTMLFormElement
  const loginBtn = document.getElementById('login-btn') as HTMLButtonElement
  const registerBtn = document.getElementById('register-btn') as HTMLButtonElement
  const errorDiv = document.getElementById('auth-error')!
  const successDiv = document.getElementById('auth-success')!

  function showError(msg: string) {
    errorDiv.textContent = msg
    errorDiv.classList.remove('hidden')
    successDiv.classList.add('hidden')
  }

  function showSuccess(msg: string) {
    successDiv.textContent = msg
    successDiv.classList.remove('hidden')
    errorDiv.classList.add('hidden')
  }

  function setLoading(loading: boolean) {
    loginBtn.disabled = loading
    registerBtn.disabled = loading
  }

  loginBtn.addEventListener('click', async () => {
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim()
    const password = (form.elements.namedItem('password') as HTMLInputElement).value
    if (!email || !password) return
    setLoading(true)
    const { error } = await supabase.auth.signInWithPassword({ email, password })
    if (error) {
      showError(error.message)
      setLoading(false)
    } else {
      window.location.href = '/'
    }
  })

  registerBtn.addEventListener('click', async () => {
    const pwdInput = form.elements.namedItem('password') as HTMLInputElement
    pwdInput.setAttribute('autocomplete', 'new-password')
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim()
    const password = (form.elements.namedItem('password') as HTMLInputElement).value
    if (!email || !password) return
    setLoading(true)
    const { error } = await supabase.auth.signUp({ email, password })
    if (error) {
      const msg = error.message.toLowerCase()
      if (msg.includes('sending confirmation email') || msg.includes('email')) {
        showError('Impossibile inviare l\'email di conferma in questo momento. Riprova tra qualche minuto.')
      } else {
        showError(error.message)
      }
      setLoading(false)
    } else {
      showSuccess('Account creato! Controlla la tua email per confermare la registrazione.')
      setLoading(false)
    }
  })

  form.addEventListener('submit', e => e.preventDefault())

  // Password show/hide toggle
  const pwdToggle = document.getElementById('pwd-toggle') as HTMLButtonElement
  const pwdInput  = document.getElementById('password') as HTMLInputElement
  const iconHide  = document.getElementById('pwd-icon-hide')!
  const iconShow  = document.getElementById('pwd-icon-show')!
  pwdToggle.addEventListener('click', () => {
    const isHidden = pwdInput.type === 'password'
    pwdInput.type = isHidden ? 'text' : 'password'
    iconHide.style.display = isHidden ? 'none' : ''
    iconShow.style.display = isHidden ? '' : 'none'
  })

  // Redirect if already logged in
  supabase.auth.getSession().then(({ data }) => {
    if (data.session) window.location.href = '/'
  })
</script>
