---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import { FOLDERS } from '../../data/folders'

export async function getStaticPaths() {
  const allPrayers = await getCollection('prayers')

  // Derive all folder paths from prayer frontmatter
  const folderPaths = new Set<string>()
  for (const p of allPrayers) {
    const parts = p.data.folder.split('/')
    parts.forEach((_, i) => folderPaths.add(parts.slice(0, i + 1).join('/')))
  }

  return Array.from(folderPaths).map(folder => ({
    params: { slug: folder },
    props: { folderId: folder },
  }))
}

const { folderId } = Astro.props
const allPrayers = await getCollection('prayers')

// Direct prayers in this folder
const directPrayers = allPrayers
  .filter(p => p.data.folder === folderId)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))

// Direct subfolders (one level deeper)
const subfolderIds = [...new Set(
  allPrayers
    .filter(p => p.data.folder.startsWith(folderId + '/'))
    .map(p => {
      const rest = p.data.folder.slice(folderId.length + 1)
      return folderId + '/' + rest.split('/')[0]
    })
)]

const folderMeta = FOLDERS[folderId]
const title = folderMeta?.title ?? folderId
const description = folderMeta?.description

// Count items in a subfolder (for badge)
function countInSubfolder(id: string) {
  return allPrayers.filter(p => p.data.folder === id || p.data.folder.startsWith(id + '/')).length
}

// Parent path for back button
const parts = folderId.split('/')
const parentPath = parts.length > 1 ? `/cartella/${parts.slice(0, -1).join('/')}` : '/'

// Breadcrumb: un crumb per ogni livello, escluso quello corrente (già nel titolo h1)
const breadcrumbFolders = parts.slice(0, -1).map((_, i) => {
  const path = parts.slice(0, i + 1).join('/')
  return { title: FOLDERS[path]?.title ?? path.split('/').pop(), url: `/cartella/${path}` }
})

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://spadadellospirito.org" },
    { "@type": "ListItem", "position": 2, "name": title, "item": `https://spadadellospirito.org/cartella/${folderId}` },
  ]
}
---

<Layout title={`${title} — Preghiere`} description={description} jsonLd={breadcrumbJsonLd}>
  <nav class="breadcrumb" aria-label="Percorso">
    <a href="/">Home</a>
    {breadcrumbFolders.map(b => (
      <>
        <span class="breadcrumb-sep">›</span>
        <a href={b.url}>{b.title}</a>
      </>
    ))}
    <span class="breadcrumb-sep">›</span>
    <span class="breadcrumb-current" aria-current="page">{title}</span>
  </nav>

  <a href={parentPath} class="back-link">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    Indietro
  </a>

  <h1>{title}</h1>
  {description && <p class="prayer-description">{description}</p>}

  {subfolderIds.map(subId => {
    const subMeta = FOLDERS[subId]
    const subTitle = subMeta?.title ?? subId.split('/').pop() ?? subId
    const count = countInSubfolder(subId)
    return (
      <a href={`/cartella/${subId}`} style="text-decoration:none">
        <div class="list-item">
          <span class="list-item-left">
            <span class="list-item-glyph" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/></svg>
            </span>
            <span class="list-item-title-wrap">
              <span class="list-item-title">{subTitle}</span>
            </span>
          </span>
          <span class="list-item-icon">
            <span class="folder-badge">{count}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </span>
        </div>
      </a>
    )
  })}

  {directPrayers.map(prayer => (
    <a href={`/preghiera/${prayer.id.replace(/\.md$/, '')}`} style="text-decoration:none">
      <div class="list-item">
        <span class="list-item-left">
          <span class="list-item-glyph" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </span>
          <span class="list-item-title-wrap">
            <span class="list-item-title">{prayer.data.title}</span>
          </span>
        </span>
        <span class="list-item-icon">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </span>
      </div>
    </a>
  ))}

  {subfolderIds.length === 0 && directPrayers.length === 0 && (
    <div class="empty-state">
      <p>Nessuna preghiera in questa cartella.</p>
      <div style="display:flex;gap:.6rem;flex-wrap:wrap;justify-content:center">
        <a href={parentPath} class="btn btn-secondary">Torna indietro</a>
        <a href="/proposta" class="btn btn-primary">Proponi una preghiera</a>
      </div>
    </div>
  )}
</Layout>
