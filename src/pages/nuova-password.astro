---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Nuova password" description="Imposta una nuova password per il tuo account." noindex={true}>
  <div class="auth-page">
    <div class="auth-card">
      <h1 class="auth-title">Nuova password</h1>

      <div id="loading-section">
        <p class="auth-subtitle">Verifica in corso...</p>
      </div>

      <div id="form-section" style="display:none">
        <p class="auth-subtitle" style="margin-bottom:1.2rem">Scegli una nuova password per il tuo account.</p>
        <div id="np-error" class="auth-error hidden"></div>
        <div id="np-success" class="auth-success hidden"></div>
        <form id="np-form" class="auth-form">
          <div class="form-group">
            <label for="new-password">Nuova password</label>
            <input type="password" id="new-password" name="password" required
              autocomplete="new-password" minlength="6" maxlength="64" class="form-input"
              placeholder="Minimo 6 caratteri" />
          </div>
          <div class="form-group">
            <label for="confirm-password">Conferma password</label>
            <input type="password" id="confirm-password" name="confirm" required
              autocomplete="new-password" minlength="6" maxlength="64" class="form-input" />
          </div>
          <div class="auth-actions">
            <button type="submit" id="submit-btn" class="btn btn-primary">Salva password</button>
          </div>
        </form>
      </div>

      <div id="invalid-section" style="display:none">
        <p class="auth-subtitle">Il link non è valido o è scaduto.</p>
        <div class="auth-actions" style="margin-top:1rem">
          <a href="/reset-password" class="btn btn-primary">Richiedi un nuovo link</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase'

  const loadingSection = document.getElementById('loading-section')!
  const formSection    = document.getElementById('form-section')!
  const invalidSection = document.getElementById('invalid-section')!
  const form           = document.getElementById('np-form') as HTMLFormElement
  const submitBtn      = document.getElementById('submit-btn') as HTMLButtonElement
  const errorDiv       = document.getElementById('np-error')!
  const successDiv     = document.getElementById('np-success')!

  function showForm() {
    loadingSection.style.display = 'none'
    formSection.style.display = 'block'
  }

  function showInvalid() {
    loadingSection.style.display = 'none'
    invalidSection.style.display = 'block'
  }

  // Supabase fires PASSWORD_RECOVERY when the user lands here via the reset link
  supabase.auth.onAuthStateChange((event, _session) => {
    if (event === 'PASSWORD_RECOVERY') {
      showForm()
    }
  })

  // Fallback: if session already has recovery token processed synchronously
  supabase.auth.getSession().then(({ data }) => {
    if (data.session) {
      // If onAuthStateChange already showed the form, do nothing.
      // Otherwise the user landed here without a recovery token.
      if (formSection.style.display === 'none' && invalidSection.style.display === 'none') {
        // Give onAuthStateChange a chance to fire first
        setTimeout(() => {
          if (formSection.style.display === 'none') showInvalid()
        }, 800)
      }
    } else {
      setTimeout(() => {
        if (formSection.style.display === 'none') showInvalid()
      }, 800)
    }
  })

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    errorDiv.classList.add('hidden')
    successDiv.classList.add('hidden')

    const pwd     = (form.elements.namedItem('password') as HTMLInputElement).value
    const confirm = (form.elements.namedItem('confirm') as HTMLInputElement).value

    if (pwd !== confirm) {
      errorDiv.textContent = 'Le password non coincidono.'
      errorDiv.classList.remove('hidden')
      return
    }

    submitBtn.disabled = true

    const { error } = await supabase.auth.updateUser({ password: pwd })

    if (error) {
      errorDiv.textContent = 'Errore durante il salvataggio. Riprova.'
      errorDiv.classList.remove('hidden')
      submitBtn.disabled = false
    } else {
      successDiv.textContent = 'Password aggiornata! Reindirizzamento...'
      successDiv.classList.remove('hidden')
      form.style.display = 'none'
      setTimeout(() => { window.location.href = '/' }, 1500)
    }
  })
</script>
