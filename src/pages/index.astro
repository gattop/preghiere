---
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import { TOP_LEVEL_FOLDERS, FOLDERS } from '../data/folders'
import CalendarioLiturgico from '../components/CalendarioLiturgico'

const allPrayers = await getCollection('prayers')

// Count prayers per top-level folder (including nested)
function countInFolder(folderId: string) {
  return allPrayers.filter(p =>
    p.data.folder === folderId || p.data.folder.startsWith(folderId + '/')
  ).length
}
---

<Layout
  title="Spada dello Spirito"
  description="Spada dello Spirito è una raccolta di preghiere cattoliche: Santo Rosario guidato, Vangelo del giorno, Bibbia CEI, litanie e preghiere tradizionali della fede cristiana."
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Spada dello Spirito",
    "url": "https://spadadellospirito.org",
    "description": "Raccolta di preghiere cattoliche: Santo Rosario, Vangelo del giorno, Bibbia CEI e preghiere tradizionali.",
    "inLanguage": "it",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "https://spadadellospirito.org/bibbia?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }}
>
  <div class="hero">
    <span class="hero-eyebrow">✝ Raccolta di preghiere cattoliche</span>
    <h1 class="hero-heading">
      La fede è fondamento<br />di ciò che si spera,
      <span class="accent-word">prova di ciò che non si vede.</span>
    </h1>
    <div class="hero-btns" style="margin-top:1.2rem">
      <a href="/rosario"  class="btn btn-primary">🕊️ Santo Rosario</a>
      <a href="/vangelo"  class="btn btn-light">📖 Vangelo del giorno</a>
      <a href="/bibbia"   class="btn btn-light">📜 Bibbia CEI</a>
    </div>
  </div>

  <CalendarioLiturgico client:load />
  <span class="section-label">Preghiere</span>

  <div class="prayer-search-wrap">
    <input
      type="search"
      id="prayer-search"
      placeholder="Cerca una preghiera..."
      class="prayer-search-input"
      autocomplete="off"
    />
  </div>

  <div class="home-grid" id="prayer-grid">
    {TOP_LEVEL_FOLDERS.map((id, i) => {
      const meta = FOLDERS[id]
      const count = countInFolder(id)
      return (
        <a href={`/cartella/${id}`} class="home-card" data-title={meta?.title ?? id} style={`animation-delay:${i * 0.07}s`}>
          <span class="home-card-icon">{meta?.icon ?? '🙏'}</span>
          <span class="home-card-title">{meta?.title ?? id}</span>
          <span class="home-card-count">{count} {count === 1 ? 'preghiera' : 'preghiere'}</span>
        </a>
      )
    })}
  </div>

  <div id="prayer-search-results" class="prayer-search-list" hidden></div>
</Layout>

<script>
  const input = document.getElementById('prayer-search') as HTMLInputElement
  const grid = document.getElementById('prayer-grid') as HTMLDivElement
  const results = document.getElementById('prayer-search-results') as HTMLDivElement

  type PrayerEntry = { id: string; title: string; folder: string }
  let allPrayers: PrayerEntry[] = []

  async function loadPrayers() {
    if (allPrayers.length) return
    try {
      const res = await fetch('/api/prayers.json')
      if (res.ok) allPrayers = await res.json()
    } catch {}
  }

  input.addEventListener('input', async () => {
    const q = input.value.trim().toLowerCase()
    if (!q) {
      grid.hidden = false
      results.hidden = true
      return
    }
    await loadPrayers()
    const matches = allPrayers.filter(p => p.title.toLowerCase().includes(q))
    grid.hidden = true
    results.hidden = false
    if (!matches.length) {
      results.innerHTML = '<p class="empty" style="padding:.5rem 0">Nessuna preghiera trovata.</p>'
      return
    }
    results.innerHTML = matches.map(p =>
      `<a href="/preghiera/${p.id}" class="list-item" style="text-decoration:none">
        <span class="list-item-title">${p.title}</span>
        <span class="list-item-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></span>
      </a>`
    ).join('')
  })
</script>
