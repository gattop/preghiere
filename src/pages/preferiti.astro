---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Preferiti" description="Le tue preghiere preferite su Spada dello Spirito." noindex={true}>
  <div class="page-header">
    <h1>Preferiti</h1>
  </div>
  <div id="preferiti-root">
    <p class="loading-text">Caricamento...</p>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase'
  import { escHtml } from '../utils/escHtml'

  const root = document.getElementById('preferiti-root')!

  async function load() {
    const { data: { session } } = await supabase.auth.getSession()
    if (!session) {
      root.innerHTML = `
        <div class="empty-state">
          <p>Accedi per vedere i tuoi preferiti.</p>
          <a href="/accedi" class="btn btn-primary">Accedi</a>
        </div>
      `
      return
    }

    const { data: favs, error } = await supabase
      .from('favorites')
      .select('prayer_id, created_at')
      .eq('user_id', session.user.id)
      .order('created_at', { ascending: false })

    if (error) {
      root.innerHTML = `<p class="error-text">Errore nel caricamento dei preferiti.</p>`
      return
    }

    if (!favs || favs.length === 0) {
      root.innerHTML = `
        <div class="empty-state">
          <p>Non hai ancora nessun preferito.</p>
          <p>Apri una preghiera e tocca il cuore per aggiungerla ai preferiti.</p>
          <a href="/" class="btn btn-secondary">Sfoglia le preghiere</a>
        </div>
      `
      return
    }

    const items = favs.map(f => {
      const id = f.prayer_id as string
      const label = id.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())
      return `<a href="/preghiera/${id}" class="prayer-list-item">${escHtml(label)}</a>`
    }).join('')

    root.innerHTML = `<div class="prayer-list">${items}</div>`
  }

  load()
</script>
