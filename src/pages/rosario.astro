---
import '../styles/global.css'
import RosarioPlayer from '../components/RosarioPlayer'
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Santo Rosario — Spada dello Spirito</title>
    <meta name="description" content="Prega il Santo Rosario guidato con i misteri del giorno: gaudiosi, dolorosi, gloriosi e luminosi. Audio e testo completo." />
    <meta property="og:site_name" content="Spada dello Spirito" />
    <meta property="og:title" content="Santo Rosario — Spada dello Spirito" />
    <meta property="og:description" content="Prega il Santo Rosario guidato con i misteri del giorno: gaudiosi, dolorosi, gloriosi e luminosi." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://spadadellospirito.org/rosario" />
    <meta property="og:image" content="https://spadadellospirito.org/favicon/icon-512.png" />
    <meta property="og:image:alt" content="Logo Spada dello Spirito" />
    <meta property="og:locale" content="it_IT" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://spadadellospirito.org/rosario" />
    <link rel="icon" type="image/png" href="/favicon/logo.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#9B8DF8" />
    <script type="application/ld+json">{JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Santo Rosario — Spada dello Spirito",
      "url": "https://spadadellospirito.org/rosario",
      "description": "Prega il Santo Rosario guidato con i misteri del giorno.",
      "inLanguage": "it",
      "isPartOf": { "@type": "WebSite", "url": "https://spadadellospirito.org" }
    })}</script>
  </head>
  <body>
    <h1 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap">Santo Rosario guidato — Spada dello Spirito</h1>
    <RosarioPlayer client:load />
  </body>
</html>
